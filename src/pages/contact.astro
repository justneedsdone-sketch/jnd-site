---
import Layout from '../layouts/Layout.astro';

const SITE_TITLE = 'Just Needs Done Enterprises';
const SITE_DESCRIPTION = 'Contact Just Needs Done Enterprises — fast, clean, affordable print & sign work.';

const EMAIL = 'Just.Needs.Done@gmail.com';
const FACEBOOK_URL = 'https://www.facebook.com/JustNeedsDone';

// Google Maps search link works on desktop and mobile.
const MAPS_URL =
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent('511 1st St, LaSalle, IL 61301 (Located inside of Whatnots & More)');
---

<Layout title={`Contact | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="page-shell">
    <header class="page-hero">
      <h1>Contact</h1>
      <p class="lede">
        Email is the fastest way to reach us. Include size, quantity, and deadline and we’ll quote it quick.
      </p>
    </header>

    <section class="card-grid" aria-label="Contact options">
      <article class="content-card">
        <h2>Email</h2>

        <p class="value">
          <a class="text-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>

        <p class="action">
          <a class="text-link" href={`mailto:${EMAIL}`}>Send an email</a>
        </p>
      </article>

      <article class="content-card">
        <h2>Address</h2>

        <p class="value">
          <a class="text-link" href={MAPS_URL} target="_blank" rel="noopener noreferrer">
            511 1st St. LaSalle, IL 61301<br />
            <span class="muted location-note">(Located inside of Whatnots &amp; More)</span>
          </a>
        </p>

        <p class="action">
          <a class="text-link" href={MAPS_URL} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
        </p>
      </article>

      <article class="content-card">
        <h2>Facebook</h2>

        <p class="value">
          <a class="text-link" href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">
            Just Needs Done
          </a>
        </p>

        <p class="action">
          <a class="text-link" href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">
            Message us on Facebook
          </a>
        </p>
      </article>
    </section>
  </section>
</Layout>

<style>
  .content-card h2 {
    font-size: 1.45rem;
  }

  .value {
    margin: 0;
  }

  .action {
    margin: 0.9rem 0 0;
  }

  .location-note {
    font-weight: 600;
  }
</style>
