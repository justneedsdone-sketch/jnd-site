---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const PAGE_TITLE = `Page Not Found | ${SITE_TITLE}`;
const PAGE_DESC = 'The requested page could not be found.';
---

<Layout title={PAGE_TITLE} description={PAGE_DESC}>
	<section class="not-found" aria-labelledby="not-found-title">
		<p class="error-code">404</p>
		<h1 id="not-found-title">Page not found</h1>
		<p>The page may have moved, or the address may be incorrect.</p>
		<nav class="actions" aria-label="Helpful pages">
			<a class="primary" href="/">Return home</a>
			<a href="/services/">View services</a>
			<a href="/contact/">Contact us</a>
		</nav>
	</section>
</Layout>

<style>
	.not-found {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem;
		text-align: center;
		background: #fff;
		border: 1px solid rgba(var(--black), 12%);
		border-radius: 18px;
	}

	.error-code {
		margin: 0;
		color: var(--accent-red);
		font-size: 1rem;
		font-weight: 900;
		letter-spacing: 0.12em;
	}

	h1 {
		margin: 0.5rem 0;
	}

	.not-found > p:last-of-type {
		margin: 0;
		color: rgba(var(--black), 72%);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.actions a {
		padding: 0.75rem 1rem;
		border: 1px solid rgba(var(--black), 14%);
		border-radius: 12px;
		color: var(--accent-dark);
		font-weight: 900;
		text-decoration: none;
	}

	.actions a.primary {
		border-color: transparent;
		background: var(--accent);
		color: #fff;
	}

	.actions a:focus-visible {
		outline: 3px solid rgba(16, 96, 160, 0.25);
		outline-offset: 2px;
	}
</style>
