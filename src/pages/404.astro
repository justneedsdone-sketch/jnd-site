---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const PAGE_TITLE = `Page Not Found | ${SITE_TITLE}`;
const PAGE_DESC = 'The requested page could not be found.';
---

<Layout title={PAGE_TITLE} description={PAGE_DESC}>
	<section class="page-shell page-shell--narrow">
		<div class="page-hero not-found" aria-labelledby="not-found-title">
			<p class="error-code">404</p>
			<h1 id="not-found-title">Page not found</h1>
			<p class="lede">The page may have moved, or the address may be incorrect.</p>
			<nav class="button-row" aria-label="Helpful pages">
				<a class="button button--primary" href="/">Return home</a>
				<a class="button" href="/services/">View services</a>
				<a class="button" href="/contact/">Contact us</a>
			</nav>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		text-align: center;
	}

	.error-code {
		margin: 0;
		color: var(--jnd-red);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: 0.14em;
	}

	.not-found .lede {
		margin-inline: auto;
	}

	.button-row {
		justify-content: center;
	}
</style>
