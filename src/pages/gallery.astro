---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE } from "../consts";

const PAGE_TITLE = `Gallery | ${SITE_TITLE}`;
const PAGE_DESC = "Examples of recent print & sign work by Just Needs Done Enterprises.";

const EMAIL = "Just.Needs.Done@gmail.com";
const FACEBOOK_URL = "https://www.facebook.com/JustNeedsDone";
---

<Layout title={PAGE_TITLE} description={PAGE_DESC}>
  <section class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">Recent work</p>
      <h1>Gallery</h1>
      <p class="lede">
        We’ll start loading real job photos here as you publish new work posts. Want your job featured?
        Send it over.
      </p>

      <div class="button-row">
        <a
          class="button button--primary"
          href={`mailto:${EMAIL}?subject=Gallery%20Feature%20-%20Just%20Needs%20Done`}
        >
          Email a photo to feature
        </a>
        <a class="button" href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">
          Message us on Facebook
        </a>
      </div>
    </header>

    <section id="featured-post" class="content-panel facebook-panel" aria-label="Featured Facebook post">
      <h2>Featured</h2>
      <iframe
        src="https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2FJustNeedsDone%2Fposts%2Fpfbid02DNzm9Y6EHMTjdoqH4GLhxWJeNXkZc6CF1QW2nUNCL78YbV1Hk65nSi29KMc8KnvRl&show_text=true&width=500"
        scrolling="no"
        allowfullscreen="true"
        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
        loading="lazy"
        title="Just Needs Done Facebook post"
      ></iframe>
    </section>

    <section class="content-panel" aria-label="Gallery status">
      <h2>Coming next</h2>
      <ul>
        <li>A grid of recent jobs</li>
        <li>Categories (banners, yard signs, window perf, etc.)</li>
        <li>Pulling photos + summaries from your <code>/work</code> posts</li>
      </ul>
      <p class="muted">
        Right now, your gallery is a placeholder while we build the automatic feed from your Cloudflare “Work” posts.
      </p>
    </section>

    <section class="info-bar" aria-label="How to submit">
      <h2>How to send a job photo</h2>
      <ol>
        <li>Send 1–3 photos</li>
        <li>Add the business name + what we did</li>
        <li>Tell us if it’s OK to post publicly</li>
      </ol>
      <div class="email-line">
        <strong>Email:</strong>
        <a class="text-link" href={`mailto:${EMAIL}?subject=Gallery%20Feature%20-%20Just%20Needs%20Done`}>
          {EMAIL}
        </a>
      </div>
    </section>
  </section>
</Layout>

<style>
  .facebook-panel {
    max-width: 620px;
    margin-inline: auto;
    scroll-margin-top: 10rem;
  }

  .content-panel h2,
  .info-bar h2 {
    font-size: 1.5rem;
  }

  .content-panel ul,
  .info-bar ol {
    margin: 0 0 0.75rem;
    padding-left: 1.4rem;
  }

  .facebook-panel iframe {
    display: block;
    width: 100%;
    height: clamp(420px, 52vw, 520px);
    border: 0;
  }

  .email-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
</style>
