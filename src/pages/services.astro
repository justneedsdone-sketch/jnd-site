---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE } from "../consts";

const PAGE_TITLE = `Services | ${SITE_TITLE}`;
const PAGE_DESC =
  "Business cards, yard signs, banners, window perf, stickers/vinyl, sublimation, and button formats.";
---

<Layout title={PAGE_TITLE} description={PAGE_DESC}>
  <section class="page-shell">
    <header class="page-hero">
      <p class="eyebrow">Fast • Clean • Affordable</p>
      <h1>Services</h1>
      <p class="lede">
        Tell us what you need (size, quantity, deadline) and we’ll quote it quick.
      </p>

      <div class="button-row">
        <a class="button button--primary" href="/contact/">Get a quick quote</a>
        <a
          class="button"
          href="https://www.facebook.com/JustNeedsDone"
          target="_blank"
          rel="noopener noreferrer"
        >
          Message us on Facebook
        </a>
      </div>
    </header>

    <section class="card-grid" aria-label="Service categories">
      <article class="content-card">
        <h2>Business Cards</h2>
        <p>Clean, professional cards that help you look legit and close.</p>
      </article>

      <article class="content-card">
        <h2>Yard Signs</h2>
        <p>Bold, readable signs for promotions, events, and campaigns.</p>
      </article>

      <article class="content-card">
        <h2>Banners</h2>
        <p>Big impact for grand openings, sales, and storefront promotions.</p>
      </article>

      <article class="content-card">
        <h2>Window Perf</h2>
        <p>Storefront graphics that look great and still let light in.</p>
      </article>

      <article class="content-card">
        <h2>Stickers / Vinyl</h2>
        <p>Decals, labels, and vinyl graphics for branding and info.</p>
      </article>

      <article class="content-card">
        <h2>Sublimation</h2>
        <p>Cups, tumblers, towels, license plates, and more — custom printed fast.</p>
      </article>

      <article class="content-card wide">
        <h2>Button Formats</h2>
        <p>
          Buttons, magnets, spinners, keychains, mirrors, mirrored keychains — great for promos,
          giveaways, and merch.
        </p>
      </article>
    </section>

    <section class="info-bar" aria-label="How to get a quote">
      <strong>Quick start:</strong>
      Email <a class="text-link" href="mailto:Just.Needs.Done@gmail.com">Just.Needs.Done@gmail.com</a>
      with what you need + size + quantity + deadline.
    </section>
  </section>
</Layout>

<style>
  .content-card h2 {
    font-size: 1.35rem;
  }

  .content-card p {
    margin: 0;
  }

  .wide {
    grid-column: 1 / -1;
  }
</style>
