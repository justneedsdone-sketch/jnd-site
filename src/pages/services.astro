---
import Layout from "../layouts/Layout.astro";
import { services } from "../data/site";
---
<Layout title="Services | Just Needs Done" description="Printing, signs, displays, apparel, and custom products from Just Needs Done.">
	<section class="page-intro"><p class="eyebrow">WHAT CAN WE HELP YOU MAKE?</p><h1>Services</h1><p>One local partner for print, signs, apparel and custom products. Start with the category that fits&mdash;or contact us and we&rsquo;ll help sort out the details.</p></section>
	<section class="service-section inner-section"><div class="service-grid">{services.map((service) => <article class="service-card"><h2 class="service-title">{service.title}</h2><p class="service-intro">{service.kicker}</p><div class="service-image"><img src={service.image} alt={service.alt}/></div><div class="service-body"><ul>{service.items.map((item) => <li>{item}</li>)}</ul><a href="mailto:Just.Needs.Done@gmail.com?subject=JND%20service%20question">Ask about this service <span>&rarr;</span></a></div></article>)}</div></section>
	<section class="simple-cta"><h2>Not sure which service fits?</h2><p>Tell us what you&rsquo;re trying to make and we&rsquo;ll help with the next step.</p><div><a class="button button-red" href="tel:+18153390044">Call 815-339-0044</a><a class="button button-blue" href="mailto:Just.Needs.Done@gmail.com?subject=Website%20quote%20request">Get a quote</a></div></section>
</Layout>
