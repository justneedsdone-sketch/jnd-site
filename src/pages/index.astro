---
import Layout from "../layouts/Layout.astro";
import { services } from "../data/site";
---
<Layout title="Just Needs Done" description="Local printing, signs, apparel, and custom products in LaSalle, Illinois.">
	<section class="hero"><div class="hero-wave hero-wave-one"></div><div class="hero-wave hero-wave-two"></div>
		<div class="hero-copy"><img class="hero-logo" src="/assets/jnd-primary-logo.png" alt="Just Needs Done"/><p class="eyebrow">WHEN YOU JUST NEED IT DONE</p><h1>Your local print, sign &amp; custom product partner.</h1><p class="hero-lede">From business essentials to bold displays, we help local businesses, organizations and families turn ideas into finished work.</p><div class="hero-actions"><a class="button button-red" href="tel:+18153390044">Call 815-339-0044</a><a class="button button-blue" href="mailto:Just.Needs.Done@gmail.com?subject=Website%20quote%20request">Get a quote</a><a class="button button-white" href="/services">Explore services</a></div><p class="tagline-support">When you just need it done &mdash; call Just Needs Done!</p></div>
		<div class="hero-visual"><img src="/assets/hero-storefront-transformation.jpg" alt="Corner Oasis storefront transformation from old window graphics to a new finished design"/><div class="photo-note"><span>REAL JND WORK</span><strong>Storefront transformation from old to new.</strong></div></div>
	</section>
	<section class="home-overview"><div class="section-heading"><p class="eyebrow">START HERE</p><h2>What do you need done?</h2><p>Choose a clear next step, or call and we&rsquo;ll point you in the right direction.</p></div><div class="overview-grid">{services.map((service) => <a class="overview-card" href="/services"><img src={service.image} alt=""/><span>{service.kicker}</span><h3>{service.title}</h3><strong>View services &rarr;</strong></a>)}<a class="overview-card overview-visit" href="/visit"><img src="/assets/whatnots-and-more-address.png" alt="Whatnots and More"/><span>INSIDE WHATNOTS AND MORE</span><h3>Visit the shop</h3><strong>Hours &amp; directions &rarr;</strong></a></div></section>
	<section class="home-cta"><p class="eyebrow">REAL WORK. LOCAL HELP.</p><h2>See what we&rsquo;ve been making.</h2><p>Browse approved photos of recent JND print, sign, apparel and custom-product work.</p><a class="button button-blue" href="/our-work">View our work</a></section>
</Layout>
