---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE } from "../consts";

const PAGE_TITLE = `${SITE_TITLE}`;
const PAGE_DESC = "Print & signs done fast: business cards, yard signs, banners, and more.";

const EMAIL = "Just.Needs.Done@gmail.com";
const SUBJECT = "Quote Request - Just Needs Done";
const MAILTO = `mailto:${EMAIL}?subject=${encodeURIComponent(SUBJECT)}`;

const FB_URL = "https://www.facebook.com/JustNeedsDone";
const ADDRESS_TEXT = "511 1st St., LaSalle, IL 61301 (Located inside of Whatnots & More)";
const MAPS_URL = "https://www.google.com/maps/search/?api=1&query=511%201st%20St%2C%20LaSalle%2C%20IL%2061301";
---

<Layout title={PAGE_TITLE} description={PAGE_DESC}>
	<section class="page-shell home">
		<div class="page-hero">
			<p class="eyebrow">When you just need it done</p>
			<h1>Print &amp; signs that make you look legit.</h1>
			<p class="lede">
				Business cards, yard signs, banners, and more — made fast, clean, and affordable for small businesses,
				nonprofits, and the public.
			</p>
			<p class="location">
				<a class="text-link" href={MAPS_URL} target="_blank" rel="noopener noreferrer">{ADDRESS_TEXT}</a>
			</p>

			<div class="promo" aria-label="Promo video">
				<a class="button button--emphasis button--wide" href="/gallery/#featured-post">Watch our promo video</a>
			</div>

			<div class="button-row" aria-label="Primary actions">
				<a class="button button--primary" href={MAILTO}>Get a quick quote</a>
				<a class="button button--emphasis" href="/contact/">Contact</a>
				<a class="button" href="/services/">See services</a>
				<a class="button" href={FB_URL} target="_blank" rel="noopener noreferrer">Message on Facebook</a>
			</div>

			<div class="card-grid" aria-label="Top services">
				<article class="content-card">
					<h2>Business Cards</h2>
					<p>Clean, professional cards that help you close.</p>
				</article>
				<article class="content-card">
					<h2>Yard Signs</h2>
					<p>Fast turnaround, bold and readable from the road.</p>
				</article>
				<article class="content-card">
					<h2>Banners</h2>
					<p>Big impact for events, storefronts, and promotions.</p>
				</article>
			</div>

			<div class="info-bar" aria-label="Quick start">
				<strong>Quick start:</strong>
				Email <a class="text-link" href={MAILTO}>{EMAIL}</a> with what you need + size + quantity + deadline.
			</div>
		</div>
	</section>

	<style>
		.location {
			max-width: var(--jnd-reading-max);
			margin: 0.85rem 0 0;
		}

		.promo {
			margin-top: 1rem;
		}

		.content-card h2 {
			font-size: 1.35rem;
		}

		.content-card p {
			margin: 0;
		}
	</style>
</Layout>
