---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="inner">
		<p class="copyright">
			© {year} Just Needs Done Enterprises, LLC. All rights reserved.
		</p>

		<p class="tagline">
			When you just need it done — call Just Needs Done!
		</p>

		<p class="contact">
			<a href="mailto:Just.Needs.Done@gmail.com">Just.Needs.Done@gmail.com</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding: 2.25rem var(--jnd-gutter);
		border-top: 4px solid var(--jnd-red);
		background: var(--jnd-deep-blue);
		color: var(--jnd-white);
	}

	.inner {
		max-width: 1100px;
		margin: 0 auto;
		text-align: center;
	}

	.copyright {
		margin: 0;
		font-size: 0.95rem;
		color: var(--jnd-white);
	}

	.tagline {
		margin: 0.75rem 0 0;
		font-weight: 700;
	}

	.contact {
		margin: 0.75rem 0 0;
	}

	.contact a {
		color: var(--jnd-white);
		font-weight: 600;
		text-decoration-color: rgba(252, 252, 252, 0.65);
	}

	.contact a:hover {
		color: var(--jnd-white);
		text-decoration-color: currentColor;
	}
</style>
