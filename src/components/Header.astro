---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";

// IMPORTANT: paste your working Facebook page URL here:
const FB_URL = "https://www.facebook.com/JustNeedsDone";
---

<header class="site-header">
	<nav class="nav" aria-label="Primary navigation">
		<a class="brand" href="/" aria-label="Just Needs Done Enterprises home">
			<img
				class="brand-logo"
				src="/jnd-logo.png"
				alt="Just Needs Done Enterprises logo"
				width="52"
				height="52"
				loading="eager"
				decoding="async"
			/>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/services">Services</HeaderLink>
			<HeaderLink href="/gallery">Gallery</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>

		<div class="right">
			<a
				class="icon-btn"
				href={FB_URL}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Visit Just Needs Done on Facebook"
			>
				<!-- Facebook icon -->
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89
						1.09 0 2.23.2 2.23.2v2.46h-1.25c-1.23 0-1.61.76-1.61 1.54V12h2.74l-.44 2.89h-2.3v6.99A10 10 0 0 0 22 12z"
					/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 2px solid var(--jnd-royal-blue);
		background: var(--jnd-white);
		box-shadow: 0 2px 8px rgba(8, 49, 111, 0.08);
	}

	.nav {
		display: grid;
		grid-template-columns: minmax(0, auto) minmax(0, 1fr) auto;
		align-items: center;
		gap: 1.25rem;
		width: 100%;
		max-width: var(--jnd-shell-max);
		margin: 0 auto;
		padding: 0.65rem var(--jnd-gutter);
	}

	.brand {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.65rem;
		color: var(--jnd-deep-blue);
		text-decoration: none;
	}

	.brand-logo {
		width: 52px;
		height: 52px;
		flex: 0 0 52px;
		display: block;
		object-fit: contain;
	}

	.brand-name {
		font-family: "Oswald", "Arial Narrow", Arial, sans-serif;
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1.15;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.25rem;
		min-width: 0;
	}

	.nav-links :global(a) {
		min-height: 44px;
		padding: 0.55rem 0.7rem;
		border: 1px solid transparent;
		border-radius: var(--jnd-radius-small);
		color: var(--jnd-deep-blue);
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
	}

	.nav-links :global(a:hover) {
		border-color: var(--jnd-border);
		background: var(--jnd-panel);
	}

	.nav-links :global(a.active) {
		border-color: var(--jnd-royal-blue);
		background: var(--jnd-royal-blue);
		color: var(--jnd-white);
	}

	.right {
		display: flex;
		align-items: center;
	}

	.icon-btn {
		display: inline-flex;
		width: 44px;
		height: 44px;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--jnd-deep-blue);
		border-radius: 50%;
		background: var(--jnd-deep-blue);
		color: var(--jnd-white);
		text-decoration: none;
		transition: background-color 150ms ease, border-color 150ms ease;
	}

	.icon-btn:hover {
		border-color: var(--jnd-royal-blue);
		background: var(--jnd-royal-blue);
		color: var(--jnd-white);
	}

	.icon-btn svg {
		width: 22px;
		height: 22px;
	}

	@media (max-width: 760px) {
		.nav {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.5rem 0.75rem;
			padding-block: 0.55rem;
		}

		.nav-links {
			grid-column: 1 / -1;
			grid-row: 2;
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 0.3rem;
		}

		.nav-links :global(a) {
			width: 100%;
			padding-inline: 0.25rem;
			font-size: 0.875rem;
		}

		.right {
			grid-column: 2;
			grid-row: 1;
		}
	}

	@media (max-width: 390px) {
		.brand-logo {
			width: 46px;
			height: 46px;
			flex-basis: 46px;
		}

		.brand-name {
			font-size: 1rem;
		}
	}
</style>
